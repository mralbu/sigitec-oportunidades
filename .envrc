# Ambiente do projeto: .venv do uv no PATH e autocompletar do fish.
watch_file pyproject.toml uv.lock

uv sync --quiet
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

# O direnv só exporta variáveis de ambiente e não altera o fish_complete_path da
# sessão. Por isso o script vai para o diretório de completions do usuário, que o
# fish carrega sob demanda no primeiro <Tab>. O script só chama o próprio CLI, então
# fora do projeto (sem o comando no PATH) ele não faz nada.
fish_completions="${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions"
if command -v fish >/dev/null; then
  mkdir -p "$fish_completions"
  sigitec-oportunidades completion fish >"$fish_completions/sigitec-oportunidades.fish"
fi
